# Reference perft counts.
#
# THIS IS NOT A GOLDEN. No step regenerates it, and `cargo xtask golden-update` does not
# touch it. These node counts are facts about chess -- every correct engine produces them,
# they are published in half a dozen places, and they were reproduced here against a
# pristine upstream Stockfish build. A mismatch is therefore ALWAYS a movegen bug in rfish,
# never a candidate for an update.
#
# Format: <chess960>;<depth>;<expected>;<fen>
#
# The chess960 flag decides how the castling field is read, so it is part of the row rather
# than a mode the runner is in: the same FEN can mean two different positions.

# --- the standard battery ---------------------------------------------------
# Position 1: the initial position.
false;1;20;rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1
false;5;4865609;rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1

# Position 2 ("Kiwipete"): every move type at once -- castling both sides, en passant,
# promotions, pins. The single most useful movegen test there is.
false;4;4085603;r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1

# Position 3: a pawn endgame that exercises en passant and promotion edge cases.
false;6;11030083;8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1

# Position 4: promotions under check, and a discovered check on the back rank.
false;5;15833292;r3k2r/Pppp1ppp/1b3nbN/nP6/BBP1P3/q4N2/Pp1P2PP/R2Q1RK1 w kq - 0 1

# Position 5: a promotion race with the king in the corner.
false;4;2103487;rnbq1k1r/pp1Pbppp/2p5/8/2B5/8/PPP1NnPP/RNBQK2R w KQ - 1 8

# Position 6: a quiet middlegame, which catches ordering bugs the tactical ones miss.
false;4;3894594;r4rk1/1pp1qppp/p1np1n2/2b1p1B1/2B1P1b1/P1NP1N2/1PP1QPPP/R4RK1 w - - 0 10

# --- Chess960 ---------------------------------------------------------------
# Castling in 960 moves the king and the rook to the SAME squares as in standard chess,
# from arbitrary starting files -- so either can already be standing where the other must
# go. These three positions cover the cases a standard-chess generator gets wrong.
true;4;326672;bqnb1rkr/pp3ppp/3ppn2/2p5/5P2/P2P4/NPP1P1PP/BQ1BNRKR w HFhf - 2 9
true;4;667366;2nnrbkr/p1qppppp/8/1ppb4/6PP/3PP3/PPP2P2/BQNNRBKR w HEhe - 1 9
true;4;273318;b1q1rrkb/pppppppp/3nn3/8/P7/1PPP4/4PPPP/BQNNRKRB w GE - 1 9
